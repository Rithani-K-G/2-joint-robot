
<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="two_joint_robot">

  <xacro:arg name="controllers_file" default=""/>

  <!-- Materials -->
  <material name="blue">
    <color rgba="0.15 0.35 0.75 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.95 0.45 0.08 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.18 0.18 0.20 1.0"/>
  </material>

  <!-- World and base -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.08"/>
      <geometry>
        <cylinder radius="0.16" length="0.16"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.08"/>
      <geometry>
        <cylinder radius="0.16" length="0.16"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.08"/>
      <mass value="4.0"/>
      <inertia ixx="0.025" ixy="0" ixz="0"
               iyy="0.025" iyz="0" izz="0.035"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Link 1: Rotating vertical column -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.22"/>
      <geometry>
        <cylinder radius="0.065" length="0.44"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.22"/>
      <geometry>
        <cylinder radius="0.065" length="0.44"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.22"/>
      <mass value="2.0"/>
      <inertia ixx="0.035" ixy="0" ixz="0"
               iyy="0.035" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <!-- Joint 1: Base rotation around Z -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14"
           effort="100.0" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Link 2: Upper arm -->
  <link name="link2">
    <visual>
      <origin xyz="0.20 0 0"/>
      <geometry>
        <box size="0.40 0.09 0.09"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.20 0 0"/>
      <geometry>
        <box size="0.40 0.09 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.20 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.014" iyz="0" izz="0.014"/>
    </inertial>
  </link>

  <!-- Joint 2: Shoulder rotation, tilted 15 degrees upward -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>

    <!-- Mounting position and upward tilt -->
    <origin xyz="0 0 0.40" rpy="0 0.261799"/>

    <!-- Rotation axis -->
    <axis xyz="0 1 0"/>

    <limit lower="-1.57" upper="1.57"
           effort="100.0" velocity="1.0"/>

    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- ROS 2 Control -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Harmonic Plugin -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

</robot>
